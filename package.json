{
  "name": "srf-news-german-learning",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend run test",
    "format": "prettier --write frontend",
    "format:check": "prettier --check frontend"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3"
  },
  "lint-staged": {
    "backend/{app,tests}/**/*.py": [
      "backend/.venv/bin/python -m ruff check --fix --force-exclude",
      "backend/.venv/bin/python -m ruff format --force-exclude"
    ],
    "backend/wsgi.py": [
      "backend/.venv/bin/python -m ruff check --fix --force-exclude",
      "backend/.venv/bin/python -m ruff format --force-exclude"
    ],
    "frontend/**/*.{ts,tsx,js,jsx,mjs,cjs,vue,json,yml,yaml,md,css}": [
      "prettier --write"
    ]
  }
}
