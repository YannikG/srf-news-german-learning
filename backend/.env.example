# --- News ingest (active upstream; article rows store ``news_provider``) ---
# Default when unset: srgssr. Allowed: srgssr, newsapi.
#NEWS_ACTIVE_PROVIDER=srgssr

# --- NewsAPI.org (only needed when NEWS_ACTIVE_PROVIDER=newsapi) ---
# API key from https://newsapi.org/account (required).
#NEWSAPI_API_KEY=
# Endpoint: everything | top-headlines (default: everything).
#NEWSAPI_ENDPOINT=everything
# For endpoint "everything": at least one of NEWSAPI_DEFAULT_QUERY, NEWSAPI_DOMAINS,
# or NEWSAPI_SOURCES must be non-empty, otherwise NewsAPI returns HTTP 400.
#NEWSAPI_DEFAULT_QUERY=
#NEWSAPI_DOMAINS=
#NEWSAPI_SOURCES=
# Language (ISO 639-1), default: de.
#NEWSAPI_DEFAULT_LANGUAGE=de
# Country (ISO 3166-1), used only for top-headlines, default: de.
#NEWSAPI_DEFAULT_COUNTRY=de
# Sort order for "everything": relevancy, popularity, publishedAt (default).
#NEWSAPI_SORT_BY=publishedAt
# Results per page, 1-100, default: 20.
#NEWSAPI_PAGE_SIZE=20
# Base URL override (optional, default: https://newsapi.org).
#NEWSAPI_BASE_URL=https://newsapi.org

# Datei ``backend/.env`` und/oder ``backend/local.env`` (beide in ``.gitignore``).
# Beim normalen App-Start (nicht pytest ``TESTING``) lädt ``create_app`` diese Dateien
# automatisch über ``python-dotenv`` (siehe ``app/bootstrap/load_dotenv_files.py``).
# ``local.env`` überschreibt gleiche Schlüssel aus ``.env``.
# Unter Docker weiterhin ``environment:`` / ``env_file:`` in Compose nutzen.

# --- SRG OAuth (News-Refresh, Articles-Upstream) ---
# Keine Anführungszeichen um die Werte, keine Zeilenenden nach dem Secret (sonst oft HTTP 400).
#SRGSSR_CONSUMER_KEY=
#SRGSSR_CONSUMER_SECRET=
#SRGSSR_TOKEN_URL=https://api.srgssr.ch/oauth/v1/accesstoken
#SRGSSR_USER_AGENT=srf-news-german-learning

# --- SRG Articles HTTP-Client (optional, Defaults wie in README) ---
#SRGSSR_ARTICLES_BASE_URL=https://api.srgssr.ch/srgssr-articles/v2
#SRGSSR_ARTICLES_USER_AGENT=srf-news-german-learning

# --- Sidecar (Ollama per Docker, Health ``sidecar``-Feld) ---
# Leer lassen = kein Sidecar, UI ohne Start/Stopp/Ruhezustand.
#SIDECAR_BASE_URL=http://127.0.0.1:8090
#SIDECAR_SHARED_SECRET=dev-sidecar-secret

# --- Ollama HTTP (Vereinfachen, Embeddings; in Compose gesetzt) ---
#OLLAMA_BASE_URL=http://127.0.0.1:11434
#OLLAMA_SIMPLIFY_MODEL=gemma4:e2b

# --- Idle-Ruhezustand (optional, Defaults 600 / 60 Sekunden) ---
#OLLAMA_IDLE_SHUTDOWN_SECONDS=600
#OLLAMA_SHUTDOWN_WARNING_SECONDS=60
# Hintergrund-Poll-Thread (lokal oft ``true``; Tests setzen ``TESTING``)
#OLLAMA_IDLE_START_POLL_THREAD=true

# --- Pfade (lokal abweichend von ``/data`` in Docker) ---
#DATABASE_PATH=./app.db
# Vektordatenbank; Standard sonst: gleiches Verzeichnis wie ``app.db``, Datei ``vectors.db``
#VECTORS_DATABASE_PATH=./vectors.db

# --- PONS Dictionary (optional; leer = Feature deaktiviert) ---
#PONS_API_SECRET=

# --- SPA aus ``frontend/dist`` (optional; leer = eingebetteter Build im Image) ---
#STATIC_SPA_DIR=
